{
  "name": "fanchatbot-backend",
  "main": "src/index.js",
  "compatibility_date": "2025-06-05",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // CORS (see src/index.js) checks the request's Origin header
    // against this — must be the scheme+host only, no path, and no
    // trailing slash (GitHub Pages serves this repo at
    // https://bayeziddev.github.io/smartflow.ai/, but the Origin
    // header on requests from that page is just the host part).
    "FRONTEND_URL": "https://bayeziddev.github.io",
    "DB_HOST": "gateway01.ap-northeast-1.prod.aws.tidbcloud.com",
    "DB_PORT": "4000",
    "DB_DATABASE": "fanchatbot"
  }

  // Secrets (set via `wrangler secret put NAME`):
  //   DB_USER
  //   DB_PASSWORD
  //   JWT_SECRET
  //   ENCRYPTION_MASTER_KEY
}

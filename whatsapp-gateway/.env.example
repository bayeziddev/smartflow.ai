# Copy to .env (never commit it) or set these in your host's dashboard.

# Shared secret: the SAME value as the backend's WA_GATEWAY_SECRET (at least 16 characters).
# Generate one with:  openssl rand -hex 32
GATEWAY_SECRET=

# The SmartFlow backend (Cloudflare Worker).
BACKEND_URL=https://fanchatbot-backend.sayadmdbayezidhosan.workers.dev

# Where WhatsApp logins are stored. Must be a persistent disk/volume.
DATA_DIR=./data
PORT=8790
LOG_LEVEL=info
